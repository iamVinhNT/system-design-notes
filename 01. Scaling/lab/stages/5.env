# Stage 5: nginx also caches anonymous reads for 5s (CDN/edge stand-in).
COMPOSE_PROFILES=lb,redis,replica
SESSION_STORE=redis
CACHE=on
# Lab only: lets `Cache-Control: no-cache` read through the cache (the *-cold workloads). Never enable on a public service.
ALLOW_CACHE_BYPASS=on
CACHE_TTL_SECONDS=30
REPLICA_URL=postgres://lab:labpass@replica:5432/lab
READ_AFTER_WRITE_SECONDS=5
EDGE_MAX_AGE_SECONDS=5
LB_CONF=lb-edge.conf
ENTRY_URL=http://127.0.0.1:8080
LOAD_TARGET=http://lb:8080
